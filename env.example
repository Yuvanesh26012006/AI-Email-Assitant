# OpenAI API Key (required for AI features)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=""
# LLM Model Configuration (optional)
# Options: gpt-4, gpt-4-turbo-preview, gpt-3.5-turbo
LLM_MODEL=gpt-4

# LLM Temperature (optional, 0.0 - 1.0)
LLM_TEMPERATURE=0.7

# Email Fetch Settings
MAX_EMAILS=50
CALENDAR_DAYS_AHEAD=30

# Flask Server Settings
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=True

# Memory Settings
MEMORY_DIR=./memory
CHECKPOINT_DB=./memory/checkpoints.db

# Google OAuth Settings (auto-configured from credentials.json)
# No manual configuration needed
